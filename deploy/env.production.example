# Продакшен-конфиг. Кладётся на сервер в /opt/budget/.env, права 600, владелец budget.
#
#   scp deploy/env.production.example root@СЕРВЕР:/opt/budget/.env
#   ssh root@СЕРВЕР 'chown budget:budget /opt/budget/.env && chmod 600 /opt/budget/.env'
#   ssh root@СЕРВЕР 'nano /opt/budget/.env'

NODE_ENV=production

# ---------- Telegram ----------
BOT_TOKEN=токен_от_BotFather
BOT_USERNAME=имя_вашего_бота_без_собаки
MINIAPP_URL=https://budget.example.com

# Название приложения: показывается в заголовке вкладки и настройках.
VITE_APP_NAME=Бюджет

# ---------- API ----------
# Слушаем только localhost — наружу отдаёт nginx.
API_PORT=3000
API_PUBLIC_URL=https://budget.example.com
# Общий секрет между ботом и API. Сгенерировать: openssl rand -hex 32
INTERNAL_API_KEY=замените_на_случайную_строку

# Фото чеков лежат вне каталога с кодом, чтобы выкладка их не затирала.
UPLOAD_DIR=/var/lib/budget/uploads

# ---------- База данных ----------
# Пароль создаётся при настройке сервера:
#   su - postgres -c "psql -c \"ALTER USER budget WITH PASSWORD 'пароль'\""
DATABASE_URL="postgresql://budget:пароль@localhost:5432/budget?schema=public"

# ---------- Курсы валют ----------
EXCHANGE_API_BASE=https://api.exchangerate.host

# ---------- Прокси ----------
# Нужен, только если с сервера недоступен api.telegram.org (например, сервер в России).
# Для локаций вне РФ оставьте пустым.
# TELEGRAM_PROXY=http://127.0.0.1:10808

# ---------- Напоминания ----------
# Час по UTC, когда бот рассылает напоминания о регулярных платежах.
RECURRING_CHECK_HOUR=9

# ---------- Безопасность ----------
# ОБЯЗАТЕЛЬНО false в проде: иначе любой, кто откроет адрес в браузере,
# попадёт в приложение без проверки подписи Telegram.
ALLOW_DEV_AUTH=false
