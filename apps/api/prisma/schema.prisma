generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BudgetKind {
  personal
  family
}

enum TxType {
  income
  expense
  transfer
}

enum CategoryType {
  income
  expense
}

enum ThemeMode {
  system
  light
  dark
}

model User {
  id           Int      @id @default(autoincrement())
  telegramId   String   @unique
  name         String
  username     String?
  avatarUrl    String?
  languageCode String?
  createdAt    DateTime @default(now())

  createdBudgets Budget[]           @relation("BudgetCreator")
  memberships    BudgetMember[]
  accounts       Account[]
  transactions   Transaction[]
  recurring      RecurringPayment[]
  settings       UserSettings?
}

model UserSettings {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  baseCurrency String    @default("RUB")
  theme        ThemeMode @default(system)

  dailyReminder     Boolean @default(false)
  dailyReminderTime String  @default("21:00")
  tzOffsetMinutes   Int     @default(180)
  dailyLastSentAt   DateTime?
  dailyAlways       Boolean @default(false)

  seenTips String[] @default([])
}

model Budget {
  id   Int        @id @default(autoincrement())
  name String
  kind BudgetKind @default(personal)
  icon String     @default("👛")

  inviteCode String? @unique

  monthlyLimit  Float?
  limitCurrency String @default("RUB")
  demoLimit     Boolean @default(false)

  createdById Int
  createdBy   User     @relation("BudgetCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  members      BudgetMember[]
  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  plans        BudgetPlan[]
  recurring    RecurringPayment[]

  @@index([createdById])
}

model BudgetMember {
  id       Int      @id @default(autoincrement())
  budgetId Int
  userId   Int
  joinedAt DateTime @default(now())

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([budgetId, userId])
  @@index([userId])
}

model Account {
  id          Int    @id @default(autoincrement())
  budgetId    Int
  ownerUserId Int
  name        String
  icon        String @default("💳")
  color       String @default("#6EC1FF")
  currency    String @default("RUB")

  initialBalance Float @default(0)
  balance        Float @default(0)

  isShared   Boolean  @default(true)
  isArchived Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  owner  User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  transactions      Transaction[]      @relation("TxAccount")
  incomingTransfers Transaction[]      @relation("TxToAccount")
  recurring         RecurringPayment[]

  @@index([budgetId])
  @@index([ownerUserId])
}

model Category {
  id       Int          @id @default(autoincrement())
  budgetId Int
  name     String
  type     CategoryType
  icon     String       @default("🏷")
  color    String       @default("#8E8E93")
  group    String?

  isArchived Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  transactions Transaction[]
  plans        BudgetPlan[]
  recurring    RecurringPayment[]

  @@index([budgetId, type])
}

model Transaction {
  id          Int    @id @default(autoincrement())
  budgetId    Int
  accountId   Int
  toAccountId Int?
  categoryId  Int?
  userId      Int
  type        TxType

  amount   Float
  currency String
  convertedAmount Float
  toConvertedAmount Float?
  rate              Float @default(1)

  date            DateTime
  comment         String?
  receiptPhotoUrl String?
  isRecurring     Boolean  @default(false)
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  budget    Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  account   Account   @relation("TxAccount", fields: [accountId], references: [id], onDelete: Cascade)
  toAccount Account?  @relation("TxToAccount", fields: [toAccountId], references: [id], onDelete: SetNull)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([budgetId, date])
  @@index([accountId, date])
  @@index([categoryId])
}

model BudgetPlan {
  id            Int   @id @default(autoincrement())
  budgetId      Int
  categoryId    Int
  year          Int
  month         Int
  plannedAmount Float @default(0)

  budget   Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([budgetId, categoryId, year, month])
  @@index([budgetId, year, month])
}

model RecurringPayment {
  id          Int    @id @default(autoincrement())
  budgetId    Int
  ownerUserId Int
  accountId   Int
  categoryId  Int?
  title       String
  amount      Float
  currency    String
  type        TxType @default(expense)

  dayOfMonth Int
  notifyTime String    @default("10:00")
  isActive   Boolean   @default(true)
  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())

  budget   Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  owner    User      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([budgetId])
  @@index([ownerUserId])
}

model ExchangeRate {
  id        Int      @id @default(autoincrement())
  base      String
  quote     String
  rate      Float
  date      String
  fetchedAt DateTime @default(now())

  @@unique([base, quote, date])
}
