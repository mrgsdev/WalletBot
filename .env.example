# ---------- Общие ----------
NODE_ENV=development

# ---------- Telegram ----------
# Токен бота от @BotFather
BOT_TOKEN=123456789:AA...replace_me
# Публичный HTTPS-URL Mini App (ngrok / cloudflare tunnel / прод-домен)
MINIAPP_URL=https://your-tunnel.ngrok-free.app
# Username бота без @ — нужен для генерации инвайт-ссылок
BOT_USERNAME=my_budget_bot

# Название приложения: показывается в заголовке вкладки и настройках.
VITE_APP_NAME=Бюджет

# ---------- API ----------
API_PORT=3000
# Публичный URL API (для CORS и ссылок на загруженные чеки)
API_PUBLIC_URL=http://localhost:3000
# Внутренний ключ, которым бот ходит в API
INTERNAL_API_KEY=change_me_internal_key
# Куда складывать фото чеков. Пусто — рядом с кодом (apps/api/uploads).
# На сервере укажите каталог с данными, например /var/lib/budget/uploads
UPLOAD_DIR=

# ---------- База данных ----------
DATABASE_URL="postgresql://postgres:пароль@localhost:5432/budget_dev?schema=public"

# ---------- Прокси ----------
# Нужен, если api.telegram.org недоступен напрямую (блокировки, корпоративная сеть).
# Если не задан, берутся системные HTTPS_PROXY / HTTP_PROXY.
# TELEGRAM_PROXY=http://127.0.0.1:10808

# ---------- Курсы валют ----------
EXCHANGE_API_BASE=https://api.exchangerate.host

# ---------- Разработка ----------
# Разрешить вход без валидной подписи initData (ТОЛЬКО для локальной разработки в браузере)
ALLOW_DEV_AUTH=true
DEV_USER_ID=1000001
DEV_USER_NAME=Локальный Разработчик
